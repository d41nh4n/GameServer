{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamepanel.local/schemas/valheim-mod-manifest.schema.json",
  "title": "GamePanel Valheim Mod Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageId", "version", "source", "target", "enabled", "dependencies", "files", "sha256", "testedGameBuild", "labTested"],
  "properties": {
    "packageId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$" },
    "source": { "type": "string", "enum": ["thunderstore", "local"] },
    "target": { "type": "string", "enum": ["server-only", "client-only", "client-server"] },
    "enabled": { "type": "boolean" },
    "dependencies": { "type": "array", "maxItems": 128, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}@[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$" } },
    "files": { "type": "array", "maxItems": 4096, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "testedGameBuild": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "labTested": { "type": "boolean" }
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "REPLACE_WITH_random_64_char_secret_used_for_signing_tokens",
    "Issuer": "GamePanelApi",
    "Audience": "GamePanelClient",
    "ExpiryMinutes": 30
  },
  "Tailscale": {
    "RequireTailscale": false,
    "Subnet": "100.64.0.0/10"
  },
  "GameServers": {
    "Valheim": {
      "ExecutablePath": "{HOME}/.local/share/Steam/steamapps/common/Valheim dedicated server/valheim_server.x86_64"
    },
    "ProjectZomboid": {
      "ServiceName": "pzserver-game.service",
      "ControlExecutable": "/usr/local/sbin/pz-gamectl",
      "InstallPath": "{PZ_HOME}/steamcmd/zomboid",
      "ConfigDirectory": "{PZ_HOME}/Zomboid/Server",
      "DefaultServerName": "servertest_new",
      "RconHost": "127.0.0.1",
      "RconPort": 27015,
      "SudoUser": ""
    }
  }
}
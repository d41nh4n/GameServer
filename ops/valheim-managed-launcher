#!/usr/bin/env bash
set -euo pipefail

# GamePanel-managed Doorstop launcher. Runtime arguments are supplied by the caller.
readonly BASE_DIR="${GAMEPANEL_VALHEIM_SERVER_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)}"
cd "$BASE_DIR"
export DOORSTOP_ENABLED=1
export DOORSTOP_TARGET_ASSEMBLY="$BASE_DIR/BepInEx/core/BepInEx.Preloader.dll"
export LD_LIBRARY_PATH="$BASE_DIR/linux64:$BASE_DIR/doorstop_libs:${LD_LIBRARY_PATH:-}"
if [[ -f "$BASE_DIR/doorstop_libs/libdoorstop_x64.so" ]]; then
 export LD_PRELOAD="$BASE_DIR/doorstop_libs/libdoorstop_x64.so${LD_PRELOAD:+:${LD_PRELOAD}}"
else
 unset DOORSTOP_ENABLED DOORSTOP_TARGET_ASSEMBLY LD_PRELOAD
fi
exec "$@"

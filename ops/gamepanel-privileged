#!/usr/bin/env python3
import json, os, pwd, socket, struct, sys, threading
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from privileged_broker import Broker, load_config

SOCKET=Path('/run/gamepanel/privileged.sock'); CONFIG=Path('/etc/gamepanel/privileged.json'); MAX=65536

def peer_uid(conn):
 return struct.unpack('3i',conn.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))[1]
def serve(conn,cfg):
 try:
  conn.settimeout(10); raw=b''
  while len(raw)<MAX:
   b=conn.recv(min(4096,MAX-len(raw))); raw+=b
   if b'\n' in b: break
  if b'\n' not in raw: raise ValueError('incomplete or oversized request')
  req=json.loads(raw.split(b'\n',1)[0]); uid=peer_uid(conn); result=Broker(cfg,uid=uid).handle(req)
  result.update({'requestId':req['requestId'],'action':req['action'],'instanceId':req['instanceId'],'deploymentId':req['deploymentId']})
 except Exception as e:
  result={'ok':False,'error':str(e)[:300]}
 try: conn.sendall((json.dumps(result,separators=(',',':'))+'\n').encode())
 finally: conn.close()
def main():
 cfg=load_config(CONFIG); SOCKET.parent.mkdir(mode=0o750,exist_ok=True); os.chown(SOCKET.parent,0,pwd.getpwnam('gamepanel').pw_gid); os.chmod(SOCKET.parent,0o750); SOCKET.unlink(missing_ok=True)
 s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); s.bind(str(SOCKET)); os.chown(SOCKET,0,pwd.getpwnam('gamepanel').pw_gid); os.chmod(SOCKET,0o660); s.listen(8)
 while True:
  c,_=s.accept(); threading.Thread(target=serve,args=(c,cfg),daemon=True).start()
if __name__=='__main__': main()
